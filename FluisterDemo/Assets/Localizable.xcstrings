    "Downloading the speech recognition model…" : {
      "comment" : "Indeterminate download progress.",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laai die spraakherkenningsmodel af…"
          }
        }
