    },
    "Update is ready. It applies when you stop listening." : {
      "comment" : "Banner after a new Core ML package has been verified while a listen session is still using the old files.",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die nuwe weergawe is afgelaai. Ek sal dit begin gebruik sodra jy my laat ophou luister."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The downloaded update is ready. When you stop listening, we will switch over to the new model."
          }
        }
      }
    },
    "Update the speech recognition model" : {
      "comment" : "Button when a newer Core ML package is on Hugging Face and the size is not known yet.",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hernu die spraakherkenningsmodel"
          }
        }
      }
    },
    "Update the speech recognition model (%@)" : {
      "comment" : "Button when a newer Core ML package is on Hugging Face. The variable is the download size. Listening still works with the copy already on this device.",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laai die nuwe spraakherkenningsmodel af (%@)"
          }
        }
      }
    },
    "Waiting for speech…" : {
      "comment" : "Status while the microphone is live but no voice has been heard yet.",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wag vir spraak…"
          }
        }
      }
    },
    "Waiting for their name…" : {
      "comment" : "Status after Fluister asked a new speaker to say their name.",
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wag vir hulle naam…"
          }
        }
      }
    },
    "We have a new participant in the conversation. What is your name?" : {
      "comment" : "Enrolment question shown on screen (and spoken when a matching voice exists) so a deaf reader sees what Fluister said.",
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ek hoor ŉ nuwe stem. Wat is u naam?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I hear a new voice. What is your name?"
          }
        }
      }
    },
    "Your name" : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jou naam"
          }
        }
      }
