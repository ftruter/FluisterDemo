          "stringUnit" : {
            "state" : "translated",
            "value" : "Ek luister…"
          }
        }
      }
    },
    "Looking up the latest model on Hugging Face…" : {
      "comment" : "Status while the app asks Hugging Face for the Core ML package date and size.",
      "localizations" : {
