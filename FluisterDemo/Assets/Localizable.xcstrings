          "stringUnit" : {
            "state" : "translated",
            "value" : "No speech recognition model is available."
          }
        }
      }
    },
    "On-device Core ML inference and the converter used for this Metal build. MIT." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afleiding op die toestel met Core ML, en die omsetter vir hierdie Metal-weergawe. MIT."
          }
        }
      }
    },
    "Once, on this device. Start listening turns on when it is done." : {
      "comment" : "Explains that Core ML compile is a one-time wait before listening.",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ons sal die ingestelde model weergawe stoor sodat ons volgende keer dadelik kan begin luister."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We will cache the optimised model data so we can start listening right away next time you start the app."
          }
        }
      }
    },
    "Open in Safari" : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak oop in Safari"
          }
        }
      }
    },
    "OpenAI — Whisper large-v3-turbo" : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI — Whisper large-v3-turbo"
          }
        }
      }
    },
    "Preparing the model for this device" : {
      "comment" : "Full-pane title while Core ML compiles Fluister.",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ons pas tans die spraakherkenningsmodel aan vir hierdie spesifieke toestel."
