      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoor"
          }
        }
      }
    },
    "South African Whisper for Afrikaans, SA English, and everyday code-switching. MIT." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suid-Afrikaanse Whisper vir Afrikaans, SA-Engels, en alledaagse kodewisseling. MIT."
          }
        }
      }
    },
    "Start listening" : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin luister"
          }
        }
      }
    },
    "Starts on-device transcription. Apple requires a tap before the microphone turns on." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin transkripsie op hierdie toestel. ŉ Knoppie-druk is nodig om die mikrofoon aan te skakel."
          }
        }
      }
    },
    "Stop listening" : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hou op luister"
          }
        }
      }
    },
    "The downloaded Fluister model did not match its checksums. The copy already on this device was left as-is." : {
      "comment" : "Error when SHA-256 verification failed; old files are kept.",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fluister model wat ons sopas afgelaai het is beskadig in transito. Probeer asb. weer later op ŉ stabiele WiFi. Ons sal intussen maar die vorige werkende weergawe gebruik. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Fluister model we just downloaded was damaged in transit. We will use the last good copy already on this device for the time being. You can retry the update later on a stable WiFi."
          }
        }
      }
    },
    "The downloaded Fluister model is missing files." : {
      "comment" : "Error when the Core ML folder failed the completeness check.",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die afgelaaide Fluister-model is onvolledig; vermis sommige lêers."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Fluister model we downloaded is incomplete."
          }
        }
      }
    },
    "The Fluister model is missing a tokenizer." : {
      "comment" : "Error when tokenizer.json cannot be loaded.",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fluister-model kort ŉ ‘tokenizer’."
          }
        }
      }
    },
    "The Hugging Face model listing could not be read." : {
      "comment" : "Error when the Hub JSON is unexpected.",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hugging Face-modellys kon nie gelees word nie."
          }
        }
      }
    },
    "This demo is built with these open-source models and tools. Each link opens in Safari." : {
      "comment" : "Intro on the Credits page. Links leave the app and open in Safari.",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hierdie demo is gebou met hierdie oopbron-modelle en -gereedskap. Elke skakel maak oop in Safari."
          }
        }
      }
    },
    "This is me…" : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dis ek…"
