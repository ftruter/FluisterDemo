      "comment" : "Idle status.",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gereed, jou spraak sal net op hierdie toestel bly."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ready, your speech will stay on this device."
