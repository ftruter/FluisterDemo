        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ek word belet om jou mikrofoon te gebruik."
          }
        }
      }
    },
    "Model by DigiPhyte. Inference with WhisperKit on Core ML. No cloud." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model deur DigiPhyte. Inferensie met WhisperKit op Apple Core ML. U spraak word nêrens anders heen gestuur nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model by DigiPhyte. Inference with WhisperKit on Core ML. No uploads to the cloud."
          }
        }
      }
    },
    "Model download failed (%lld)." : {
