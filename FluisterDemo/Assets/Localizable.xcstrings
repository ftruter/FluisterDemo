        }
      }
    },
    "Chooses Afrikaans or English for captions and on-device speech recognition. Autodetect is off so Afrikaans is not treated as Dutch." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies Afrikaans of Engels vir spraakherkenning op hierdie toestel. Outomatiese taalherkenning is afgeskakel sodat Afrikaans nie as Nederlands hanteer word nie."
          }
        }
      }
    },
